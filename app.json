{
  "expo": {
    "name": "Kiler",
    "slug": "Kiler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1D23"
    },
    "scheme": "kiler",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Digital archive app for storing links, photos, notes and more",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.canarslan.kiler",
      "backgroundColor": "#0F1419"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1419"
      },
      "backgroundColor": "#0F1419",
      "edgeToEdgeEnabled": true,
      "package": "com.ahmetcanarslan.kiler",
      "launchMode": "singleTask"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1419"
        }
      ],
      "expo-sqlite",
      "react-native-receive-sharing-intent"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a16f3be9-8e40-47a6-b2f0-340d6205a1aa"
      }
    }
  }
}